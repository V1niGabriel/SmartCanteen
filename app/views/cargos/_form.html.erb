<style>
  .permissions-container {
    margin-top: 20px;
    margin-bottom: 20px;
  }
  .permission-group {
    border: 1px solid #ccc;
    border-radius: 6px;
    margin-bottom: 10px;
    background-color: #fcfcfc;
  }
  .permission-group summary {
    font-weight: bold;
    padding: 12px 15px;
    cursor: pointer;
    background-color: #f1f1f1;
    border-radius: 6px;
    list-style: none; /* remove default arrow in some browsers */
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .permission-group summary::-webkit-details-marker {
    display: none; /* remove arrow in webkit */
  }
  .permission-group summary:after {
    content: "▼";
    font-size: 12px;
  }
  .permission-group[open] summary:after {
    content: "▲";
  }
  .permission-group[open] summary {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom: 1px solid #ccc;
  }
  .permission-items {
    padding: 15px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 10px;
  }
  .permission-item label {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
  }
</style>

<%= form_with(model: cargo) do |form| %>
  <% if cargo.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(cargo.errors.count, "error") %> prohibited this cargo from being saved:</h2>
      <ul>
        <% cargo.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :nome_cargo, "Nome do Cargo", style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
    <%= form.text_field :nome_cargo, style: "padding: 8px; width: 100%; max-width: 400px; border: 1px solid #ccc; border-radius: 4px;" %>
  </div>

  <div class="permissions-container">
    <h3 style="margin-bottom: 10px;">Permissões de Acesso</h3>
    
    <% Permissao.all.group_by(&:tabela).each do |tabela, permissoes| %>
      <details class="permission-group js-accordion">
        <summary>
          <%= tabela == 'all' ? 'Acesso Global / Sistema' : tabela %>
        </summary>
        <div class="permission-items">
          <%= form.collection_check_boxes :permissao_ids, permissoes.sort_by(&:acao), :id, :acao do |b| %>
            <div class="permission-item">
              <%= b.label do %>
                <%= b.check_box %>
                <%= case b.text
                    when 'read' then 'Visualizar'
                    when 'create' then 'Criar'
                    when 'update' then 'Editar'
                    when 'destroy' then 'Excluir'
                    when 'manage' then 'Liberar Acesso Total'
                    else b.text
                    end %>
              <% end %>
            </div>
          <% end %>
        </div>
      </details>
    <% end %>
  </div>

  <div class="form-actions" style="display: flex; gap: 10px; align-items: center;">
    <%= form.submit "Salvar Cargo", style: "padding: 10px 20px; background-color: #28a745; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold;" %>
    <%= link_to "Cancelar", cargos_path, class: "btn-cancel" %>
  </div>
<% end %>

<% if cargo.persisted? %>
  <div style="margin-top: 15px;">
    <%= button_to "Excluir Cargo", cargo, method: :delete, form: { data: { turbo_confirm: "Tem certeza que deseja excluir este cargo?" } }, class: "btn-delete", style: "padding: 10px 20px; background-color: #dc3545; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold;" %>
  </div>
<% end %>

<script>
  // JavaScript para habilitar o comportamento de "Accordion" (abrir um, fechar os outros)
  document.addEventListener("turbo:load", function() {
    setupAccordions();
  });

  // Fallback caso não esteja usando Turbo na página
  document.addEventListener("DOMContentLoaded", function() {
    setupAccordions();
  });

  function setupAccordions() {
    const details = document.querySelectorAll("details.js-accordion");
    
    details.forEach((targetDetail) => {
      targetDetail.addEventListener("click", () => {
        // Ignora se estiver tentando fechar a própria gaveta
        if (targetDetail.hasAttribute("open")) return;
        
        // Fecha todas as outras gavetas
        details.forEach((detail) => {
          if (detail !== targetDetail) {
            detail.removeAttribute("open");
          }
        });
      });
    });
  }
</script>
