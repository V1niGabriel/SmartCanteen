<% content_for :title, "Cargos" %>

<div class="clfc-page-header">
  <h1 class="clfc-page-title">Cargos</h1>
  <% if can? :Create, Cargo%>
    <%= link_to "+ Novo Cargo", new_cargo_path, class: "clfc-btn-primary" %>
  <% end %>
</div>

<div class="clfc-cards-grid">
  <% @cargos.each do |cargo| %>
    <div class="clfc-card-item">
      <div class="clfc-card-info">
        <h3 class="clfc-card-title"><%= cargo.nome_cargo %></h3> 
      </div>
      
      <div class="clfc-card-action">
        <%= link_to "→", edit_cargo_path(cargo), class: "clfc-btn-arrow" %>
      </div>
    </div>
  <% end %>
</div>