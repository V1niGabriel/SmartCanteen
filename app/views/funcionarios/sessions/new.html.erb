<h2>Entrar</h2>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div class="field">
    <p><%= f.label :cpf, "CPF" %></p>
    <p><%= f.text_field :cpf, autofocus: true, autocomplete: "off", maxlength: 11, inputmode: "numeric", oninput: "this.value = this.value.replace(/\\D/g, '')" %></p>
  </div>

  <div class="field">
    <p><%= f.label :password, "Senha" %></p>
    <p><%= f.password_field :password, autocomplete: "current-password" %></p>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="field">
      <p><%= f.check_box :remember_me %></p>
      <p><%= f.label :remember_me, "Lembrar de mim" %></p>
    </div>
  <% end %>

  <div class="actions">
    <%= f.submit "Entrar" %>
  </div>
<% end %>

<%= render "funcionarios/shared/links" %>
