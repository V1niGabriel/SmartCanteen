<h2>Editar conta</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "funcionarios/shared/error_messages", resource: resource %>

  <div class="field">
    <p><%= f.label :cpf, "CPF" %></p>
    <p><%= f.text_field :cpf, autocomplete: "off", maxlength: 11, inputmode: "numeric", oninput: "this.value = this.value.replace(/\\D/g, '')" %></p>
  </div>

  <div class="field">
    <p><%= f.label :nome, "Nome" %></p>
    <p><%= f.text_field :nome %></p>
  </div>

  <div class="field">
    <p><%= f.label :telefone, "Telefone" %></p>
    <p><%= f.telephone_field :telefone, maxlength: 11, oninput: "this.value = this.value.replace(/\\D/g, '')" %></p>
  </div>

  <div class="field">
    <p><%= f.label :password, "Nova senha" %> <i>(deixe em branco se não quiser alterar)</i></p>
    <p><%= f.password_field :password, autocomplete: "new-password" %></p>
  </div>

  <div class="field">
    <p><%= f.label :password_confirmation, "Confirmar nova senha" %></p>
    <p><%= f.password_field :password_confirmation, autocomplete: "new-password" %></p>
  </div>

  <div class="field">
    <p><%= f.label :current_password, "Senha atual" %> <i>(precisamos da sua senha atual para confirmar as alterações)</i></p>
    <p><%= f.password_field :current_password, autocomplete: "current-password" %></p>
  </div>

  <div class="actions">
    <%= f.submit "Atualizar" %>
  </div>
<% end %>

<h3>Cancelar conta</h3>

<div><%= button_to "Cancelar minha conta", registration_path(resource_name), data: { confirm: "Tem certeza?", turbo_confirm: "Tem certeza?" }, method: :delete %></div>

<%= link_to "Voltar", :back %>
