<%= form_with(model: funcionario) do |form| %>
  <% if funcionario.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(funcionario.errors.count, "error") %> prohibited this funcionario from being saved:</h2>

      <ul>
        <% funcionario.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :cargo_id, "Cargo", style: "display: block" %>
    <%= form.collection_select :cargo_id, @cargos, :id, :nome_cargo, prompt: "Selecione um cargo" %>
  </div>

  <div>
    <%= form.label :nome, style: "display: block" %>
    <%= form.text_field :nome %>
  </div>

  <div>
    <%= form.label :cpf, style: "display: block" %>
    <%= form.text_field :cpf, maxlength: 11, pattern: "\\d{11}", title: "Digite 11 números", inputmode: "numeric", oninput: "this.value = this.value.replace(/\\D/g, '')" %>
  </div>

  <div>
    <%= form.label :telefone, style: "display: block" %>
    <%= form.telephone_field :telefone, maxlength: 11, pattern: "\\d{10,11}", title: "Digite 10 ou 11 números", oninput: "this.value = this.value.replace(/\\D/g, '')" %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
