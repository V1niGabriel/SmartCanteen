<%= form_with(model: funcionario, class: "smart-form") do |form| %>
  <% if funcionario.errors.any? %>
    <div class= "form-errors">
      <h2><%= pluralize(funcionario.errors.count, "error") %> prohibited this funcionario from being saved:</h2>
      <ul>
        <% funcionario.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :cargo_id, "Cargo", class: "form-label" %>
    <%= form.collection_select :cargo_id, @cargos, :id, :nome_cargo, prompt: "Selecione um cargo" %>
  </div>

  <div class="form-group">
    <%= form.label :nome, class: "form-label" %>
    <%= form.text_field :nome, class: "form-input" %>
  </div>

  <div class="form-group">
    <%= form.label :cpf, class: "form-label" %>
    <%= form.text_field :cpf, class: "form-input", maxlength: 11, pattern: "\\d{11}", title: "Digite 11 números", inputmode: "numeric", oninput: "this.value = this.value.replace(/\\D/g, '')" %>
  </div>

  <div class="form-group">
    <%= form.label :telefone, class: "form-label" %>
    <%= form.telephone_field :telefone, class: "form-input", maxlength: 11, pattern: "\\d{10,11}", title: "Digite 10 ou 11 números", oninput: "this.value = this.value.replace(/\\D/g, '')" %>
  </div>

  <div class="form-group">
    <%= form.label :password, "Senha", class: "form-label" %>
    <%= form.password_field :password, class: "form-input" %>
  </div>

  <div class="form-actions">
    <%= form.submit "Salvar", class: "btn-submit" %>
    <%= link_to "Cancelar", funcionarios_path, class: "btn-cancel" %>
  </div>
<% end %>
