<% content_for :title, "Clientes" %>

<div class="clfc-page-header">
  <h1 class="clfc-page-title">Clientes</h1>
  <% if can? :Create, Cliente%>
    <%= link_to "+ Novo Cliente", new_cliente_path, class: "clfc-btn-primary" %>
  <% end %>
</div>

<div class="clfc-cards-grid">
  <% @clientes.each do |cliente| %>
    <div class="clfc-card-item">
      <div class="clfc-card-info">
        <span class="clfc-card-tag">CLIENTE</span>
        
        <h3 class="clfc-card-title"><%= cliente.nome %></h3> 
      </div>
      
      <div class="clfc-card-action">
        <%= link_to "→", edit_cliente_path(cliente), class: "clfc-btn-arrow", title: "Mostrar detalhes do cliente" %>
      </div>
    </div>
  <% end %>
</div>