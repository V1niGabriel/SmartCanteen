<%= form_with(model: venda) do |form| %>
  <% if venda.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(venda.errors.count, "error") %> prohibited this venda from being saved:</h2>

      <ul>
        <% venda.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :cliente_id, "Cliente", style: "display: block" %>
    <%= form.collection_select :cliente_id, @clientes, :id, :nome, prompt: "Selecione um cliente" %>
  </div>

  <div>
    <%= form.label :funcionario_id, "Funcionário", style: "display: block" %>
    <%= form.collection_select :funcionario_id, @funcionarios, :id, :nome, prompt: "Selecione um funcionário" %>
  </div>

  <div>
    <%= form.label :data_da_compra, style: "display: block" %>
    <%= form.datetime_field :data_da_compra %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
