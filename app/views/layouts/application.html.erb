<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || "SmartCanteen - Gestão" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="SmartCanteen">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="hero-section">
      <% if funcionario_signed_in? %>

      <nav class="navbar">
        <a href="/" class="navbar-brand">
          <%= image_tag "logo-simbolo-vazado.png", alt: "Logo SmartCanteen" %>
          SmartCanteen
        </a>
        <ul class=navbar-menu>
          <li>
            <%= link_to "Início", root_path, class: current_page?("/")? "active" : "" %>
          </li>  
          <li>
            <%= link_to "Vendas", vendas_path, class: controller_name == "vendas" ? "active" : "" %>
          </li>
          <li>
            <%= link_to "Produtos", produtos_path, class: controller_name == "produtos" ? "active" : "" %>
          </li>
          <li>
            <%= link_to "Clientes", clientes_path, class: controller_name == "clientes" ? "active" : "" %>
          </li>
          <li>
            <%= link_to "Funcionários", funcionarios_path, class: controller_name == "funcionarios" ? "active" : "" %>
          </li>
          <li>
            <%= link_to "Cargos", cargos_path, class: controller_name == "Cargos" ? "active" : ""%>
          </li>
          <%= button_to "Sair", destroy_funcionario_session_path, method: :delete %>
          <% end %>
        </ul>
      </nav>
    </div>

    <main class="main-container">
      <div class="content-card">
        
        <% flash.each do |key, message| %>
          <div class="flash-<%= key == 'notice' ? 'notice' : 'alert' %>">
            <%= message %>
          </div>
        <% end %>

        <%= yield %> 
        
      </div>
    </main>

    <footer class="footer">
      <p>&copy; <%= Time.now.year %> SmartCanteen - Desenvolvido por Ian Alves, José Miguel e Vinícius Gabriel (IF Baiano - Catu/BA)</p>
    </footer>
  </body>
</html>