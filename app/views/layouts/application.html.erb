<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || "SmartCanteen - Gestão" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="SmartCanteen">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <div class="hero-section">
      <nav class="navbar">
        <a href="/" class="navbar-brand">
          <%= image_tag "logo-simbolo-vazado.png", alt: "Logo SmartCanteen" %>
          SmartCanteen
        </a>
        <ul class=navbar-menu>
          <li>
            <%= link_to "Início", root_path, class: current_page?("/")? "active" : "" %>
          </li>
          <% if can?(:read, Venda) %>
            <li>
              <%= link_to "Vendas", vendas_path, class: controller_name == "vendas" ? "active" : "" %>
            </li>
          <% end %>
          <% if can?(:read, Produto) %>
            <li>
              <%= link_to "Produtos", produtos_path, class: controller_name == "produtos" ? "active" : "" %>
            </li>
          <% end %>
          <% if can?(:read, Cliente) %>
            <li>
              <%= link_to "Clientes", clientes_path, class: controller_name == "clientes" ? "active" : "" %>
            </li>
          <% end %>
          <% if can?(:read, Funcionario) %>
            <li>
              <%= link_to "Funcionários", funcionarios_path, class: controller_name == "funcionarios" ? "active" : "" %>
            </li>
          <% end %>
          <% if can?(:read, Cargo) %>
            <li>
              <%= link_to "Cargos", cargos_path, class: controller_name == "cargos" ? "active" : ""%>
            </li>
          <% end %>
          <% if funcionario_signed_in? %>
            <div class="user-menu-wrapper">
              <button class="menu-toggle" type="button" aria-label="Abrir menu do usuário">
                <span class="bar"></span> 
                <span class="bar"></span> 
                <span class="bar"></span> 
              </button>    
              <div class="user-dropdown" id="userMenu">
                Logado como: <strong><%= current_funcionario.nome %></strong> |
                <%= button_to "Sair", destroy_funcionario_session_path, method: :delete, class: "btn-logout" %>
              </div>
            </div>
          <% end %>
        </ul>
      </nav>
    </div>

    <main class="main-container">
      <div class="content-card">
        
        <% flash.each do |key, message| %>
          <div class="flash-<%= key == 'notice' ? 'notice' : 'alert' %>">
            <%= message %>
          </div>
        <% end %>

        <%= yield %> 
        
      </div>
    </main>

    <footer class="footer">
      <p>&copy; <%= Time.now.year %> SmartCanteen - Desenvolvido por Ian Alvares, José Miguel e Vinícius Gabriel (IF Baiano - Catu/BA)</p>
    </footer>
    <script>
      // Esta função rodará tanto no primeiro carregamento quanto em trocas de página (Turbo)
      const setupMenu = () => {
        const btn = document.querySelector(".menu-toggle");
        const menu = document.getElementById("userMenu");

        if (btn && menu) {
          // Removemos qualquer evento antigo para não duplicar
          btn.onclick = null; 
          
          btn.addEventListener("click", (e) => {
            e.preventDefault();
            e.stopPropagation();
            menu.classList.toggle("active");
            console.log("Menu clicado! Estado atual:", menu.classList.contains("active"));
          });
        }
      };

      // Escuta o carregamento normal e o do Turbo
      document.addEventListener("DOMContentLoaded", setupMenu);
      document.addEventListener("turbo:load", setupMenu);

      // Fechar ao clicar fora
      document.addEventListener("click", (e) => {
        const menu = document.getElementById("userMenu");
        if (menu && menu.classList.contains("active") && !menu.contains(e.target)) {
          menu.classList.remove("active");
        }
        });
  </script>
  </body>
</html>