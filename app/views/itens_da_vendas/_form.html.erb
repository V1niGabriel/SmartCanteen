<%= form_with(model: itens_da_venda) do |form| %>
  <% if itens_da_venda.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(itens_da_venda.errors.count, "error") %> prohibited this itens_da_venda from being saved:</h2>

      <ul>
        <% itens_da_venda.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :venda_id, "Venda", style: "display: block" %>
    <%= form.collection_select :venda_id, @vendas, :id, :id, prompt: "Selecione uma venda" %>
  </div>

  <div>
    <%= form.label :produto_id, "Produto", style: "display: block" %>
    <%= form.collection_select :produto_id, @produtos, :id, :nome, prompt: "Selecione um produto" %>
  </div>

  <div>
    <%= form.label :quantidade, style: "display: block" %>
    <%= form.number_field :quantidade %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
