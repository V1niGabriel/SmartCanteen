<%= form_with(model: produto, class: "smart-form") do |form| %>
  
  <%# Bloco para exibir erros caso o usuário tente salvar faltando informações %>
  <% if produto.errors.any? %>
    <div class="form-errors">
      <h3><%= pluralize(produto.errors.count, "erro") %> impediram de salvar:</h3>
      <ul>
        <% produto.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :nome, "Nome do Produto", class: "form-label" %>
    <%= form.text_field :nome, class: "form-input", placeholder: "Ex: Coxinha de Frango" %>
  </div>

  <div class="form-group">
    <%= form.label :tipo, "Categoria", class: "form-label" %>
    <%= form.text_field :tipo, class: "form-input", placeholder: "Ex: Salgado" %>
  </div>

  <div class="form-group">
    <%= form.label :preco, "Preço (R$)", class: "form-label" %>
    <%= form.number_field :preco, step: "0.01", class: "form-input", placeholder: "0.00" %>
  </div>

  <div class="form-actions">
    <%= form.submit "Salvar Produto", class: "btn-submit" %>
    <%= link_to "Cancelar", produtos_path, class: "btn-cancel" %>
  </div>
<% end %>