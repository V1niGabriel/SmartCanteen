<% content_for :title, "Produtos" %>

<div class="main-card-container">
   <div class="page-header-row">
      <h1>Catálogo de Produtos</h1>
      <% if can? :create, Produto %>
       <%= link_to "+ Novo Produto", new_produto_path, class: "new-prod-btn" %>
      <% end %>
    </div>
  <div id="produtos" class="card-grid-container">
    <% @produtos.each do |produto| %>
      <div class="product-item-card">
        <div class="card-image-section">
          <img src="https://via.placeholder.com/150" alt="imagem do Produto"> 
        </div>
        <div class="card-info-section">
          <div class="card-info-top">
             <%# <h2 class="product-category-title"><%= produto.tipo.upcase %><%#</h2> %>
          </div>
          <div class="card-info-bottom">
            <div class="product-details-text">
              <p class="product-name-title"><%= produto.nome %></p>
              <p class="product-price-value">R$ <%= produto.preco %></p>
            </div>
            <%= link_to "→", produto, class: "product-arrow-link" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>